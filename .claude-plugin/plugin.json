{
  "name": "workflow",
  "version": "1.1.0",
  "description": "Workflow skills from idea to reviewed code (align, plan, task-create, execute-tasks, qa, review), a qa agent, and a hook that keeps file work out of Bash.",
  "author": {
    "name": "Dario Jambrosic"
  },
  "repository": "https://github.com/djambrosic/claude-config",
  "license": "MIT",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PLUGIN_ROOT}/hooks/native-tools.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
